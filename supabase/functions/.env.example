# Edge Function secrets — NEVER commit real values, NEVER prefix with VITE_
# (anything VITE_* is bundled into the browser).
#
# Local:      copy to supabase/functions/.env and run
#             supabase functions serve --env-file supabase/functions/.env
# Production: supabase secrets set --env-file supabase/functions/.env
#             (or Supabase Dashboard → Edge Functions → Secrets)
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected by
# the platform and must not be set here.

# ---- ai-service: PRIMARY provider (required for AI features) ---------------
# Chosen by the 2026-08-23 research pass (docs/adr/0015): Google Gemini is the
# only truly free (no card) API that reads PDFs natively and returns JSON.
# Get a key at https://aistudio.google.com → "Get API key".
AI_PROVIDER=gemini
AI_PROVIDER_API_KEY=
AI_MODEL=gemini-2.5-flash
# optional overrides
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# AI_TIMEOUT_MS=90000

# ---- ai-service: optional FALLBACK (used only on rate limit / outage) ------
# Mistral free mode reads PDFs through a `document_url` content part.
# AI_FALLBACK_PROVIDER=openai_compatible
# AI_FALLBACK_PROVIDER_API_KEY=
# AI_FALLBACK_MODEL=mistral-small-latest
# AI_FALLBACK_BASE_URL=https://api.mistral.ai/v1
# AI_FALLBACK_PDF_PART=document_url
#
# Text-only alternative (cannot read PDFs; fine for feedback summaries):
# AI_FALLBACK_PROVIDER=openai_compatible
# AI_FALLBACK_MODEL=openai/gpt-oss-120b
# AI_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
# AI_FALLBACK_PDF_PART=none

# ---- event-assistant (existing, unchanged) -----------------------------------
ANTHROPIC_API_KEY=
