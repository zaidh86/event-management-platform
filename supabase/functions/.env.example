# Edge Function secrets — NEVER commit real values, NEVER prefix with VITE_
# (anything VITE_* is bundled into the browser).
#
# Local:      copy to supabase/functions/.env and run
#             supabase functions serve --env-file supabase/functions/.env
# Production: supabase secrets set --env-file supabase/functions/.env
#             (or Supabase Dashboard → Edge Functions → Secrets)
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected by
# the platform and must not be set here.
#
# ai-service provider chain (ADR-0015, verified 2026-08-23). A request runs on
# the PRIMARY; the next provider is tried ONLY after a recoverable provider
# failure (429 / 5xx / timeout / network). Order: Gemini → Mistral → OpenRouter.

# ---- PRIMARY: Google Gemini (native PDF, JSON schema output) -----------------
AI_PROVIDER=gemini
AI_PROVIDER_API_KEY=
AI_MODEL=gemini-3.7-flash
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# AI_TIMEOUT_MS=90000            per-provider timeout (min 10000)
# AI_REQUEST_BUDGET_MS=140000    whole-chain budget; keep below the Edge Function wall-clock limit
# PRIVACY: the Gemini FREE tier may use prompts (student reports) to improve
# Google products. Use a key from a project with billing enabled for the event.

# ---- FALLBACK 1: Mistral (Document QnA PDF via document_url) -----------------
AI_FALLBACK_PROVIDER=openai_compatible
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=mistral-medium-3-5
AI_FALLBACK_BASE_URL=https://api.mistral.ai/v1
AI_FALLBACK_PDF_PART=document_url

# ---- FALLBACK 2: OpenRouter (free model; PDF via the FREE cloudflare-ai parser)
# "openrouter" sends the OpenAI file part + plugins:[file-parser/cloudflare-ai]
# so the billed mistral-ocr default is never used. Text-only extraction —
# figures in the PDF are not seen by this fallback.
AI_FALLBACK2_PROVIDER=openai_compatible
AI_FALLBACK2_API_KEY=
AI_FALLBACK2_MODEL=z-ai/glm-5.2:free
AI_FALLBACK2_BASE_URL=https://openrouter.ai/api/v1
AI_FALLBACK2_PDF_PART=openrouter

# PDF_PART values: inline (Gemini, implied) | document_url (Mistral) |
# openrouter (OpenRouter + free parser) | file (plain OpenAI file part) |
# none (provider is skipped for PDF requests)

# ---- event-assistant (existing, unchanged) -----------------------------------
ANTHROPIC_API_KEY=
